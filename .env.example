
# Google Gemini API
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Gemini models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Database
DATABASE_URL=sqlite:///data/insureflow.db

# FastAPI backend
API_BASE_URL=http://127.0.0.1:8000

# Upload limits
MAX_UPLOAD_MB=10

# Logging
LOG_LEVEL=INFO
